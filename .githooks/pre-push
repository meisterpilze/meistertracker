#!/bin/sh
# Last stop before the messages leave this machine.
#
# commit-msg only sees the commit being written. A rebase, an amend with
# --no-verify, or a branch that was created before the hook was enabled can all
# carry an address to this point, so the whole outgoing range is checked again
# — plus the branch name itself, which is published just as loudly.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
scan="$(dirname "$0")/../scripts/leak-scan.js"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
	[ "$local_oid" = "$zero" ] && continue # deleting a ref pushes no text

	printf '%s' "${local_ref#refs/heads/}" | node "$scan" --stdin --label 'branch name' || status=1

	if [ "$remote_oid" = "$zero" ]; then
		# New branch: everything on it that no remote already has.
		range="$local_oid --not --remotes=origin"
	else
		range="$remote_oid..$local_oid"
	fi

	# shellcheck disable=SC2086
	node "$scan" --range $range || status=1
done

exit $status
