#!/bin/sh
# Refuse a commit message that carries the address of a live instance.
#
# This is the only layer that runs before anything is public. Everything after
# it — CI, the pull request workflow — can merely notice, because by then the
# text has already been pushed or published. That is why the hook exists even
# though CI covers the same rules.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks
#
# See CONTRIBUTING.md. To bypass in an emergency: git commit --no-verify.

exec node "$(dirname "$0")/../scripts/leak-scan.js" --message "$1"
